
<html>
    <head>
        <title>Homepage</title>
        <link rel="stylesheet" href="/styles.css">
    </head>
  <body>
   <%- include('navbar',{links:links}) %>
   
   <main>
 <p><%= message %></p>
 <h1><%= title%> </h1>
 <ul>
    <% messages.forEach((message) => { %>     
    <li>
        <p class="message"> <%=message.text %> </p>
        <p class="name"> <%=message.author %></p>
        <p class="date"> <%=message.added %></p>
        <a href="/message/<%= message.id%>">More info</a>
    </li>
    <% }) ; %>
 </ul>

   </main>




</body>
</html>