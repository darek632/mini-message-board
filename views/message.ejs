<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/styles.css">
    <title>Message</title>
</head>
<body>
    <h1> Full message info</h1>
    <div class="message-card"> 
        <h3> Author:</h3>
        <p><%= message.author %> </p>

        <h3>Message:</h3>
        <p> <%= message.text %> </p>

        <h3>Date:</h3>
        <p><%= message.added %> </p>

    </div> 
    <a href="/">Back</a>
    
    
</body>
</html>